{
	"version": "2.0.0",
	"tasks": [
		{
            "label": "Generate tlm cmd eh from design",
            "type": "shell",
            "command": "rye run python design/generate.py",
            "presentation": {
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "cargo build (monazite debug)",
            "type": "shell",
            "command": "cd monazite && cargo build",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo build (monazite release)",
            "type": "shell",
            "command": "cd monazite && cargo build --release",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        }
	]
}